APP_NAME="BayarKilat"
# Referensi untuk deploy via Docker (docker-compose.yml) / Dokploy:
# tempel variabel di bawah ke tab "Environment" UI Dokploy (ditulis ke `.env`),
# atau salin file ini menjadi `.env.staging` untuk deploy compose lokal.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# Ganti dengan domain staging milikmu (https bila di belakang Traefik/Let's Encrypt).
APP_URL=https://your-domain.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# SQLite default — data dipersist lewat volume 'bayarkilat_sqlite' di compose
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue diset 'sync' agar demo berjalan tanpa worker terpisah.
# Aktifkan worker ('database' + service queue-worker) bila nanti ada job berat.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# Server FrankenPHP (mode Octane, lihat Dockerfile). Dipakai agar generator link
# menghasilkan URL https bila application server di belakang Traefik/Let's Encrypt.
OCTANE_HTTPS=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="billing@bayarkilat.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"